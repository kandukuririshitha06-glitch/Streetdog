# PawSathi Environment Variables
# Copy this file to .env to configure live services.
# When left unset or set to placeholders, PawSathi runs in complete, functional Demo Mode.

# Firebase Configuration (Authentication, Firestore, Storage)
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# Map Configuration
# Note: PawSathi uses OpenStreetMap / Leaflet by default which requires NO paid API key!
VITE_MAP_PROVIDER=leaflet

# Optional Payment Gateway (e.g. Razorpay test mode)
VITE_RAZORPAY_KEY_ID=YOUR_RAZORPAY_TEST_KEY_ID
